<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.puretv"
    android:versionCode="6"
    android:versionName="v1.3">

    <!-- Install results reach only this app (another app can't fake one and make PureTV open a screen). -->
    <permission android:name="io.puretv.permission.INSTALL_STATUS" android:protectionLevel="signature" />
    <uses-permission android:name="io.puretv.permission.INSTALL_STATUS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="io.puretv.airplay.permission.CONTROL" />
    <!-- User-granted, read-only access to the programs apps share with Android TV. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- After the TV boots (and after a TV update), checks that custom home mode is still as you left it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Only when you choose to install the optional AirPlay receiver: Android still asks you to allow and confirm. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Only when you choose Uninstall for an app: Android shows its own confirmation. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- "Free memory": closes apps that wait in the background (Android starts them again when opened). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Only when you turn on screensaver photos: your pictures on the TV and USB drives, read-only. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Android 11+: without this list the app can't "see" the other apps (getLeanbackLaunchIntentForPackage
         returns null). The shelf and streaming apps, the live TV apps and, through the <intent>, every TV app
         (for "All Apps"). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent><action android:name="android.settings.APPLICATION_DEVELOPMENT_SETTINGS" /></intent>
        <intent><action android:name="android.settings.DEVICE_INFO_SETTINGS" /></intent>
        <intent><action android:name="android.settings.SETTINGS" /></intent>
        <intent><action android:name="android.settings.WIFI_SETTINGS" /></intent>
        <intent><action android:name="android.settings.DISPLAY_SETTINGS" /></intent>
        <intent><action android:name="android.settings.SOUND_SETTINGS" /></intent>
        <intent><action android:name="android.media.tv.action.SETUP_INPUTS" /></intent>
        <package android:name="com.netflix.ninja" />
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.wbd.stream" />
        <package android:name="com.apple.atve.androidtv.appletv" />
        <package android:name="com.hulu.livingroomplus" />
        <package android:name="com.cbs.ott" />
        <package android:name="com.peacocktv.peacockandroid" />
        <package android:name="com.globo.globotv" />
        <package android:name="com.spotify.tv.android" />
        <package android:name="com.tcl.tv" />
        <package android:name="com.google.android.tv" />
        <package android:name="com.mediatek.wwtv.tvcenter" />
        <package android:name="com.sony.dtv.tvx" />
        <package android:name="io.github.jqssun.airplay" />
        <package android:name="io.puretv.airplay" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:host="android.media.tv" />
        </intent>
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">

        <!-- New installations see the welcome guide; configured installations open settings. -->
        <activity
            android:name=".SettingsActivity"
            android:process=":home"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:taskAffinity="io.puretv.settings"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/Launcher.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".WelcomeActivity" android:process=":home" android:exported="false"
            android:screenOrientation="landscape" android:launchMode="singleTop"
            android:taskAffinity="io.puretv.settings" android:excludeFromRecents="true" android:theme="@style/Launcher.Home" />

        <activity android:name=".QuickSettingsActivity" android:process=":home" android:exported="false"
            android:screenOrientation="landscape" android:theme="@style/Launcher.Quick" />
        <activity android:name=".TvInputsActivity" android:process=":home" android:exported="false"
            android:screenOrientation="landscape" android:theme="@style/Launcher.Home" />
        <activity android:name=".RemoteTestActivity" android:process=":home" android:exported="false"
            android:screenOrientation="landscape" android:theme="@style/Launcher.Home" />
        <activity
            android:name=".DisplaySettingsActivity"
            android:process=":home"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Launcher.Home" />

        <activity
            android:name=".AirPlayActivity"
            android:process=":home"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Launcher.Home" />
        <activity
            android:name=".AirPlayInstallActivity"
            android:process=":home"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Launcher.Home" />
        <activity
            android:name=".UpdateActivity"
            android:process=":home"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Launcher.Home" />

        <activity
            android:name=".ContinueSettingsActivity"
            android:process=":home"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Launcher.Home" />

        <!-- The home screen. Its own process (:home): if it ever crashes, the safety net in the main process still
             works. It only becomes the TV's home screen in custom home mode (cmd package set-home-activity). -->
        <activity
            android:name=".ShortcutSettingsActivity"
            android:process=":home"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Launcher.Home" />

        <activity
            android:name=".HomeEditActivity"
            android:process=":home"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Launcher.Home" />

        <activity
            android:name=".DeviceStatusActivity"
            android:process=":home"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Launcher.Home" />

        <activity
            android:name=".HomeActivity"
            android:process=":home"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/Launcher.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".Screensaver"
            android:process=":home"
            android:enabled="@bool/dream_in_home"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- The same screensaver on Android 11, in the main process (see ScreensaverAlone). -->
        <service
            android:name=".ScreensaverAlone"
            android:enabled="@bool/dream_alone"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- The switches, as background jobs in the main process. -->
        <service
            android:name=".ModeJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- The remote's app buttons from inside any app (Settings > Remote Buttons). Its own process: the system waits for it on
             every key, so the home screen must never be able to slow it down. -->
        <service
            android:name=".RemoteKeyService"
            android:process=":keys"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/remote_key_service" />
        </service>

        <receiver android:name=".SleepTimer$Fire" android:exported="false" />
        <receiver
            android:name=".HomeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
